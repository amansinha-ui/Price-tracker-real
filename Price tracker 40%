# MAIN
# =========================================================

def main():

    print(
        "===================================="
    )

    print(
        "      PRICE TRACKER STARTED"
    )

    print(
        "===================================="
    )

    print(
        f"Minimum discount: {MIN_DISCOUNT}%"
    )

    print(
        f"Email destination: {EMAIL_TO}"
    )

    all_products = []

    # -----------------------------------------------------
    # Check all websites
    # -----------------------------------------------------

    for source_name, url in URLS.items():

        products = fetch_products(
            source_name,
            url,
        )

        all_products.extend(products)

    # -----------------------------------------------------
    # Remove duplicates
    # -----------------------------------------------------

    unique_products = []

    seen = set()

    for product in all_products:

        key = (
            product["source"],
            product["name"],
            product["price"],
        )

        if key in seen:
            continue

        seen.add(key)

        unique_products.append(product)

    # -----------------------------------------------------
    # Sort highest discount first
    # -----------------------------------------------------

    unique_products.sort(
        key=lambda item: item["discount"],
        reverse=True,
    )

    print(
        "\n===================================="
    )

    print(
        f"TOTAL DEALS: {len(unique_products)}"
    )

    print(
        "===================================="
    )

    for product in unique_products:

        print(
            f"{product['discount']:.1f}% | "
            f"₹{product['price']:,.0f} | "
            f"{product['name'][:80]}"
        )

    # -----------------------------------------------------
    # Send email
    # -----------------------------------------------------

    send_email(
        unique_products
    )

    print(
        "\nPRICE TRACKER FINISHED."
    )


if __name__ == "__main__":
    main()
